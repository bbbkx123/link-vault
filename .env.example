# Neon Postgres. Run `neon deploy` (or `neon env pull`) to populate these;
# DATABASE_URL is pooled and DATABASE_URL_UNPOOLED is used by migrations.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Neon Object Storage (S3-compatible). Also injected by `neon deploy`.
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_ENDPOINT_URL_S3="https://your-branch.storage.region.aws.neon.tech"
AWS_REGION="us-east-2"
OBJECT_STORAGE_BUCKET="assets"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Auth.js needs to trust the deployment host (Vercel, custom domains, proxies).
AUTH_TRUST_HOST="true"

# Used for canonical URLs and social preview metadata. Set this to the deployed
# origin (for example https://linkvault.example.com) in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional overrides, only read by `pnpm db:seed`. Uncomment and use strong
# values if you seed a shared or production database.
# SEED_ADMIN_PASSWORD="use-a-strong-password"
# SEED_DEMO_PASSWORD="use-another-strong-password"
